GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2

# Groq is always primary; local Ollama is an optional, one-way fallback.
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT_SECONDS=120

# Supabase persistence. The service-role key is server-only and must never be sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REQUIRED=false

# SMTP dispatch for email verification codes. When SMTP_USER/PASS are empty, codes are still
# generated and returned in the API response ("direct" channel) so local/dev flows keep working.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=1
FROM_EMAIL=security@cliniqo.health
